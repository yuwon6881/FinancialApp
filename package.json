{
  "name": "financialapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.js",
    "lint": "eslint .",
    "check:design-system": "node scripts/check-design-system.mjs",
    "deadcode": "knip --include files,dependencies,devDependencies",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "test:fast": "vitest run --pool=threads --maxWorkers=4",
    "test:one": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism --reporter=dot",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "test": "vitest run",
    "test:visual": "node ./node_modules/@playwright/test/cli.js test",
    "test:visual:update": "node ./node_modules/@playwright/test/cli.js test --update-snapshots",
    "pretest": "node scripts/bundle-test-dom.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@capacitor/cli": "^8.4.1",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@emnapi/wasi-threads": "^1.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.25.0",
    "msw": "^2.15.0",
    "rolldown": "^1.0.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
